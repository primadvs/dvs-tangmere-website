{
  "//": "Copy this file to local.settings.json to test on your own machine. local.settings.json is never committed to Git — it holds real secrets. In Azure itself, these same names are entered as 'Application settings' in the Function App, not in a file.",
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "node",

    "TABLES_CONNECTION_STRING": "the Storage Account connection string — Azure Portal → Storage Account → Access keys",
    "TABLE_NAME": "Enquiries",

    "ALLOWED_ORIGINS": "https://tangmere.aero,https://www.tangmere.aero,https://dvs-tangmere-website.pages.dev,https://tangmere-aircraft.com",

    "HONEYPOT_FIELD": "company",

    "GOOGLE_SENDER_EMAIL": "the real mailbox this sends from, e.g. chris@tangmere.aero — a Google Group cannot send email itself",
    "SALES_GROUP_EMAIL": "sales@tangmere.aero",
    "GOOGLE_SERVICE_ACCOUNT_JSON": "the full JSON key for the Google Cloud service account, as one line — see backend/README.md for how this is created and authorised",
    "SHEET_ID": "the long id from the shared enquiries spreadsheet's own URL — see backend/README.md. Leave unset to skip this step for now; nothing else depends on it"
  }
}
